# ──────────────────────────────────────────────
# FastAPI backend — multi-stage build
# ──────────────────────────────────────────────
FROM python:3.11-slim AS base

# Prevent .pyc files and enable unbuffered stdout/stderr for container logs
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# ── Install dependencies ──
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# ── Copy application source ──
COPY src/ src/
COPY api/ api/
COPY train.py .

# ── Copy data needed for training & inference ──
COPY Car-Data-Occasion-Clean-5.csv .
COPY Car-Data-Occasion.csv .

# ── Train the model at build time so the image ships with a ready model ──
RUN python train.py

EXPOSE 8000

# Health-check so ECS knows when the container is ready
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
